{
    "name": "coordination-network",
    "private": true,
    "packageManager": "yarn@4.17.0",
    "scripts": {
        "build": "yarn build:libraries && yarn build:contracts && yarn build:circuits",
        "build:libraries": "yarn workspaces foreach -A -t --no-private run build",
        "build:contracts": "yarn workspace coordination-network-contracts build",
        "build:circuits": "yarn workspace @coordination-network/circuits compile",
        "build:docs": "yarn workspace docs build",
        "sync:zk-artifacts": "yarn workspace @coordination-network/zk-artifacts sync",
        "start": "yarn workspace integration-testbed start",
        "demo": "yarn workspace integration-testbed demo",
        "test:demo-ui": "yarn workspace integration-testbed test:ui",
        "testbed": "yarn workspace integration-testbed start",
        "stack": "yarn workspace integration-testbed serve",
        "stack:genesis": "TESTBED_MODE=testnet yarn workspace integration-testbed serve --genesis",
        "stack:testnet": "TESTBED_MODE=testnet yarn workspace integration-testbed serve",
        "demo:network-member": "yarn workspace @coordination-network/registry-demo start:network-member",
        "demo:identity": "yarn workspace @coordination-network/registry-demo start:identity",
        "demo:member-and-identity": "yarn workspace @coordination-network/registry-demo start:member-and-identity",
        "demo:stealth": "yarn workspace @coordination-network/stealth-address-demo test",
        "test": "yarn typecheck && yarn test:circuits && yarn test:contracts && yarn test:zk-artifacts && yarn test:wallet-e2e && yarn test:libraries",
        "typecheck": "tsx scripts/typecheck.ts",
        "test:libraries": "jest --passWithNoTests --ignoreProjects indexer",
        "test:wallet-e2e": "yarn workspace @coordination-network/wallet test:e2e",
        "test:contracts": "yarn workspace coordination-network-contracts test",
        "test:circuits": "yarn workspace @coordination-network/circuits test",
        "test:zk-artifacts": "yarn workspace @coordination-network/zk-artifacts test",
        "test:library": "jest packages/${0}",
        "test:indexer": "jest --selectProjects indexer --testPathPatterns tests/unit",
        "test:indexer:integration": "yarn workspace @coordination-network/indexer pretest && jest --selectProjects indexer --testPathPatterns tests/integration",
        "test:testbed": "yarn workspace integration-testbed test",
        "coverage": "yarn coverage:libraries && yarn coverage:zk-artifacts && yarn coverage:contracts && yarn coverage:contracts:check",
        "coverage:libraries": "jest --coverage --passWithNoTests --ignoreProjects indexer --testPathIgnorePatterns /tests/integration/",
        "coverage:zk-artifacts": "yarn workspace @coordination-network/zk-artifacts coverage",
        "coverage:contracts": "yarn workspace coordination-network-contracts coverage",
        "coverage:contracts:check": "tsx scripts/check-lcov.ts",
        "lint:eslint": "eslint . --ext .js,.ts,.tsx",
        "lint:contracts": "yarn workspace coordination-network-contracts lint",
        "lint": "yarn lint:eslint && yarn lint:contracts",
        "lint:fix": "yarn lint:eslint --fix",
        "format:prettier": "prettier -c .",
        "format:prettier:write": "prettier -w .",
        "format:contracts": "yarn workspace coordination-network-contracts fmt:check",
        "format:docs": "yarn workspace docs format",
        "format": "yarn format:prettier && yarn format:contracts && yarn format:docs",
        "format:write": "yarn format:prettier:write",
        "style": "yarn lint && yarn format",
        "version:bump": "tsx scripts/version.ts ${0}",
        "version:publish": "yarn build:libraries && yarn workspaces foreach -A -t --no-private npm publish --tolerate-republish --access public",
        "version:release": "changelogithub",
        "clean": "tsx scripts/clean-apps.ts && tsx scripts/clean-packages.ts && rimraf node_modules",
        "remove:stable-version-field": "tsx scripts/remove-stable-version-field.ts && yarn format:write",
        "precommit": "lint-staged",
        "setup:git": "git config core.editor true",
        "setup:foundry": "foundryup --install v1.8.5",
        "postinstall": "husky && (yarn setup:git || true)"
    },
    "workspaces": [
        "apps/*",
        "packages/*",
        "packages/contracts/src",
        "packages/noir-prover-native/rust/MoproReactNativeBindings"
    ],
    "resolutions": {
        "@semaphore-protocol/data/axios": "^1.18.0",
        "postcss": "^8.5.23",
        "viem/ws": "^8.21.0",
        "ethers/ws": "^8.21.0",
        "jsonpath/underscore": "^1.13.8",
        "giget/tar": "^7.5.22",
        "circom_tester/snarkjs": "^0.7.6",
        "xcode/uuid": "^11.1.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.0",
        "@typescript-eslint/eslint-plugin": "^8.62.1",
        "@typescript-eslint/parser": "^8.62.1",
        "changelogithub": "patch:changelogithub@npm%3A14.0.0#~/.yarn/patches/changelogithub-npm-14.0.0-6fefb89af9.patch",
        "czg": "^1.13.1",
        "dotenv": "^17.2.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.15.4",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.4",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    }
}
