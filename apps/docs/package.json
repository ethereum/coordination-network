{
    "name": "docs",
    "version": "0.0.0",
    "private": true,
    "installConfig": {
        "hoistingLimits": "workspaces"
    },
    "scripts": {
        "docusaurus": "docusaurus",
        "start": "docusaurus start",
        "build": "docusaurus build",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc",
        "format": "yarn run -T prettier -c . --ignore-path ../../.prettierignore --ignore-path .gitignore && remark . --ext mdx --frail --quiet",
        "format:write": "yarn run -T prettier -w . --ignore-path ../../.prettierignore --ignore-path .gitignore"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/faster": "3.10.2",
        "@docusaurus/plugin-content-docs": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@docusaurus/theme-common": "3.10.2",
        "@docusaurus/theme-mermaid": "3.10.2",
        "@easyops-cn/docusaurus-search-local": "0.55.3",
        "@mdx-js/react": "^3.0.0",
        "clsx": "^2.0.0",
        "docusaurus-plugin-llms": "0.6.1",
        "prism-react-renderer": "^2.3.0",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "3.10.2",
        "@docusaurus/tsconfig": "3.10.2",
        "@docusaurus/types": "3.10.2",
        "@types/react": "~19.1.10",
        "remark-cli": "^12.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-mdx": "^3.1.1",
        "remark-preset-lint-consistent": "^6.0.1",
        "remark-preset-lint-recommended": "^7.0.1",
        "typescript": "~6.0.2"
    },
    "remarkConfig": {
        "settings": {
            "bullet": "-"
        },
        "plugins": [
            "remark-mdx",
            "remark-directive",
            "remark-preset-lint-consistent",
            "remark-preset-lint-recommended",
            [
                "remark-frontmatter",
                {
                    "type": "yaml",
                    "marker": "-"
                }
            ]
        ]
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "engines": {
        "node": ">=20.0"
    }
}
