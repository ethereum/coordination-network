PORT="3000"
TRUSTED_PROXY_ADDRESS="127.0.0.1"
RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<API_KEY>"
ANNOUNCER_ADDRESS="0x55649E01B5Df198D18D95b5cc5051630cfD45564"
# the network member's ERC-1155 scoped token
TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
START_BLOCK="25790000"
SCAN_INTERVAL_MS="5000"
MAX_BLOCK_SCAN_WINDOW_SIZE="2000"
CONFIRMATIONS="5"
# the shared secret the network member's backend authenticates with. Generate it with
# `echo "0x$(openssl rand -hex 32)"`. The service refuses to start while it is empty
AUTH_TOKEN=""
# 32 bytes of hex the sensitive stored values are encrypted with. Generate it with
# `echo "0x$(openssl rand -hex 32)"`.
ENCRYPTION_KEY=""
# 32 bytes of hex the lookup columns are hashed with. Generate it with
# `echo "0x$(openssl rand -hex 32)"`.
LOOKUP_HASH_KEY=""
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/indexer"
LOG_LEVEL="info"
LOG_FORMAT="pretty"
