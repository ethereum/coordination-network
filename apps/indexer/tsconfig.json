{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declarationDir": null,
        "types": ["node", "jest"],
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src", "tests"]
}
