{
    "expo": {
        "name": "User Wallet",
        "slug": "coordination-user-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "scheme": "userapp",
        "splash": {
            "backgroundColor": "#176b4d"
        },
        "android": {
            "package": "network.coordination.userapp"
        },
        "plugins": [
            "expo-dev-client",
            ["expo-secure-store", { "configureAndroidBackup": true }],
            "expo-camera",
            [
                "expo-build-properties",
                {
                    "android": {
                        "buildArchs": ["arm64-v8a"]
                    }
                }
            ],
            "expo-font"
        ]
    }
}
