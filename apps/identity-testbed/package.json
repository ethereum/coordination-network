{
    "name": "identity-testbed",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "check:sdk-built": "node -e \"try { require.resolve('@coordination-network/identity') } catch { console.error('\\n[identity-testbed] @coordination-network/identity has no built dist.\\nRun: yarn workspace @coordination-network/identity build (from the repo root), then retry.\\n'); process.exit(1); }\"",
        "start": "yarn check:sdk-built && expo start",
        "test": "jest",
        "eas-build-post-install": "yarn workspace @coordination-network/identity build"
    },
    "dependencies": {
        "@coordination-network/expo-identity-keystore": "workspace:^",
        "@coordination-network/identity": "workspace:^",
        "@noble/curves": "^1.9.7",
        "@noble/hashes": "^1.8.0",
        "expo": "~54.0.0",
        "expo-dev-client": "~6.0.21",
        "expo-modules-core": "3.0.30",
        "expo-secure-store": "~15.0.8",
        "expo-status-bar": "~3.0.9",
        "react": "19.1.0",
        "react-native": "0.81.5",
        "react-native-get-random-values": "~1.11.0"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@types/react": "~19.1.10",
        "jest": "~29.7.0",
        "jest-expo": "~54.0.17",
        "typescript": "~5.9.2"
    }
}
