{
    "name": "@coordination-network/zk-artifacts",
    "version": "0.1.3",
    "description": "Compiled zero-knowledge artifacts for the coordination network: the credential circuit's ACIR bytecode and ABI, and its Barretenberg UltraHonk verification key.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/zk-artifacts"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/zk-artifacts",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "browser": {
                "types": "./types/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "require": {
                "types": "./types/index.d.ts",
                "default": "./dist/index.cjs"
            },
            "default": {
                "types": "./types/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./browser": {
            "types": "./types/browser.d.ts",
            "default": "./dist/browser.js"
        },
        "./credential/circuit.json": "./credential/circuit.json",
        "./credential/vk": "./credential/vk",
        "./package.json": "./package.json"
    },
    "files": [
        "credential/",
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "noir",
        "barretenberg",
        "ultrahonk",
        "zero-knowledge",
        "circuit",
        "verification-key",
        "verifiable-credentials"
    ],
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@noir-lang/noir_js": "1.0.0-beta.22"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs",
        "sync": "tsx scripts/sync.ts",
        "test": "tsx --test tests/*.test.ts"
    },
    "devDependencies": {
        "@noir-lang/noir_js": "1.0.0-beta.22",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^24.0.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    }
}
