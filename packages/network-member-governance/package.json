{
    "name": "@coordination-network/network-member-governance",
    "version": "0.2.0",
    "description": "Governance Safe transactions for the network member registry: build the admission or removal transaction, sign it as an approved network member, and aggregate the signatures the Safe accepts on chain.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/network-member-governance"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/network-member-governance",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs"
    },
    "dependencies": {
        "@safe-global/protocol-kit": "^8.0.6",
        "@safe-global/safe-deployments": "^1.37.62",
        "@safe-global/types-kit": "^4.0.1",
        "viem": "^2.40.0"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "typescript": "^6.0.3"
    }
}
