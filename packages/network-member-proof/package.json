{
    "name": "@coordination-network/network-member-proof",
    "version": "0.2.0",
    "description": "Generates the Semaphore membership proofs that authorise an IdentityRegistry or CredentialRevocationRegistry write as an approved network member, bound to that exact update.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/network-member-proof"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/network-member-proof",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs",
        "generate:fixtures": "tsx tests/generate-fixtures.ts",
        "generate:revocation-fixtures": "tsx tests/generate-revocation-fixtures.ts"
    },
    "dependencies": {
        "@semaphore-protocol/group": "4.14.5",
        "@semaphore-protocol/identity": "4.14.5",
        "@semaphore-protocol/proof": "4.14.5",
        "viem": "^2.40.0"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "ffjavascript": "0.3.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    }
}
