{
    "name": "@coordination-network/wallet",
    "version": "0.2.0",
    "description": "Wallet SDK for the coordination network: device key management, credential storage, consent-gated presentation and revocation sync.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/wallet"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/wallet",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "installConfig": {
        "hoistingLimits": "workspaces"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "yarn test:unit && yarn test:e2e",
        "test:unit": "cd ../.. && jest --selectProjects wallet",
        "test:e2e": "tsx --test tests/wallet.e2e.ts"
    },
    "devDependencies": {
        "@coordination-network/zk-artifacts": "workspace:^",
        "@noble/curves": "^1.9.7",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.0",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.11",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@coordination-network/credential": "workspace:^",
        "@coordination-network/identity": "workspace:^",
        "@coordination-network/issuer-set": "workspace:^",
        "@coordination-network/revocation-registry": "workspace:^",
        "@noble/hashes": "^1.8.0",
        "@semaphore-protocol/identity": "4.14.5"
    }
}
