{
    "name": "@coordination-network/user-app-core",
    "version": "0.1.3",
    "description": "The three user-app-link operations a user app serves, over injected device, storage and proving ports.",
    "license": "MIT",
    "repository": "https://github.com/ethereum/coordination-network",
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/user-app-core",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs"
    },
    "dependencies": {
        "@coordination-network/credential": "workspace:^",
        "@coordination-network/identity": "workspace:^",
        "@coordination-network/issuer-set": "workspace:^",
        "@coordination-network/revocation-registry": "workspace:^",
        "@coordination-network/user-app-link": "workspace:^",
        "@coordination-network/user-client": "workspace:^",
        "@coordination-network/wallet": "workspace:^",
        "@semaphore-protocol/identity": "4.14.5",
        "zod": "^4.3.11"
    },
    "devDependencies": {
        "@noble/curves": "^1.9.7",
        "@rollup/plugin-typescript": "^12.3.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "typescript": "^6.0.3"
    }
}
