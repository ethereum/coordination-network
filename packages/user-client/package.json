{
    "name": "@coordination-network/user-client",
    "version": "0.1.3",
    "description": "Single-call onboarding and registration for the coordination network: derive device keys, encode the meta-stealth address, and register networkId -> metaStealthAddress on IdentityRegistry.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/user-client"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/user-client",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs"
    },
    "dependencies": {
        "@coordination-network/identity": "workspace:^",
        "@noble/curves": "^1.9.7",
        "@noble/hashes": "^1.8.0"
    },
    "devDependencies": {
        "@coordination-network/network-member-client": "workspace:^",
        "@coordination-network/network-member-proof": "workspace:^",
        "@rollup/plugin-typescript": "^12.3.0",
        "@semaphore-protocol/group": "4.14.5",
        "@semaphore-protocol/identity": "4.14.5",
        "ffjavascript": "0.3.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "typescript": "^6.0.3",
        "viem": "^2.55.11"
    }
}
