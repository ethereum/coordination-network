pragma solidity ^0.8.34;

import { EntryPoint } from "@account-abstraction/contracts/core/EntryPoint.sol";
import { PackedUserOperation } from "@account-abstraction/contracts/interfaces/PackedUserOperation.sol";
import { SemaphoreVerifier } from "@semaphore-protocol/contracts/base/SemaphoreVerifier.sol";

import { SemaphorePaymaster } from "../../src/SemaphorePaymaster.sol";
import { TestBase } from "./TestBase.sol";

/// @dev Fixtures are generated by test/fixtures/generateSemaphorePaymasterFixtures.ts
abstract contract SemaphorePaymasterTestBase is TestBase {
    EntryPoint entryPoint;
    SemaphoreVerifier semaphoreVerifier;
    SemaphorePaymaster semaphorePaymaster;

    address owner;
    address sender1;
    address sender2;

    uint256 constant MAX_COST_PER_OP = 0.05 ether;
    uint256 constant MAX_COST = 0.001 ether;
    uint256 constant MERKLE_TREE_DURATION = 1 hours;
    uint8 constant SAFE_CAST_TARGET_BITS = 48;

    uint256 member1Commitment;
    uint256 member2Commitment;
    bytes validProof;
    bytes wrongScopeProof;
    bytes supersededRootProof;
    bytes nonMemberProof;

    function setUp() public {
        owner = makeAddr("owner");
        sender1 = makeAddr("sender1");
        sender2 = makeAddr("sender2");

        entryPoint = new EntryPoint();
        semaphoreVerifier = new SemaphoreVerifier();
        semaphorePaymaster =
            new SemaphorePaymaster(address(entryPoint), address(semaphoreVerifier), owner, MAX_COST_PER_OP);

        string memory json = vm.readFile("test/fixtures/semaphorePaymasterProofs.json");
        member1Commitment = vm.parseJsonUint(json, ".member1Commitment");
        member2Commitment = vm.parseJsonUint(json, ".member2Commitment");
        validProof = vm.parseJsonBytes(json, ".validProof");
        wrongScopeProof = vm.parseJsonBytes(json, ".wrongScopeProof");
        supersededRootProof = vm.parseJsonBytes(json, ".supersededRootProof");
        nonMemberProof = vm.parseJsonBytes(json, ".nonMemberProof");
    }

    function _addNetworkMembers() internal {
        vm.startPrank(owner);
        semaphorePaymaster.addMember(semaphorePaymaster.GROUP_ID(), member1Commitment);
        semaphorePaymaster.addMember(semaphorePaymaster.GROUP_ID(), member2Commitment);
        vm.stopPrank();
    }

    function _validatePaymasterUserOp(address sender, bytes memory proof, uint256 maxCost)
        internal
        returns (bytes memory context, uint256 validationData)
    {
        PackedUserOperation memory userOp;
        userOp.sender = sender;
        userOp.paymasterAndData = abi.encodePacked(address(semaphorePaymaster), uint128(0), uint128(0), proof);

        vm.prank(address(entryPoint));
        return semaphorePaymaster.validatePaymasterUserOp(userOp, bytes32(0), maxCost);
    }
}
