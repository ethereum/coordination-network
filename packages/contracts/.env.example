# Only when passing keys with --private-keys. Leave empty when using Foundry keystores.
# .env private keys acceptable for testnets. On mainnet, consider storing keys in a keystore.
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=

SEPOLIA_RPC_URL=

MAINNET_RPC_URL=

# Verify deployed contracts on Etherscan.
ETHERSCAN_API_KEY=

SEPOLIA_BUNDLER_URL=

# Sends every deployment and holds no role afterwards. The deploy scripts refuse to run unless it sends them.
DEPLOYER=

# The governance Safe's founding owner and the paymaster's owner. Sends every Safe transaction and the stake. Must differ from DEPLOYER.
OWNER=

# The Safe that owns the registry and the network member group. DeployAll.s.sol writes it to the deployment file.
GOVERNANCE_SAFE=

# The most the paymaster pays for one operation, in wei.
# 0.1 ETH. 7,150,000 total gas equals roughly a worst-case revocation (Glamsterdam), at up to 13.9 gwei.
# 7,150,000 * 13.9 gwei = 99,385,000 gwei. 100,000,000 gwei is 0.1 ETH
MAX_COST_PER_OP=100000000000000000

# Who may revoke in the registry created via CreateRevocationRegistry.s.sol.
REVOCATION_ADMIN=

# FundPaymaster.s.sol: what it sponsors with, and what it must stake in order to function. Both recoverable.
PAYMASTER_DEPOSIT=100000000000000000 # 0.1 ETH
PAYMASTER_STAKE=1000000000000000000 # 1 ETH

# How long the stake stays locked after asking for it back.
PAYMASTER_UNSTAKE_DELAY=86400 # 1 day

# Where the withdrawal scripts send the recovered ETH.
PAYMASTER_WITHDRAW_TO=

# ConfigureGovernance.s.sol env vars.
APPROVED_ISSUER_SET=
NETWORK_MEMBER_GOVERNANCE=

# AdmitNetworkMember.s.sol's signer. The network member's account key and commitment come from `node script/generateNetworkMember.ts`.
NETWORK_MEMBER_MULTISIG_SIGNER=

# Only for running one script alone. DeployAll.s.sol passes these between its own scripts.
NETWORK_MEMBER_REGISTRY=
NETWORK_MEMBER_GROUP=
NETWORK_MEMBER_GROUP_ID=
SEMAPHORE_PAYMASTER=
REVOCATION=

# Only for running AdmitNetworkMember.s.sol or AddPaymasterMember.s.sol alone. Copy both from the output of
# `node script/generateNetworkMember.ts`. Deploy script `yarn deployAndConfigureAll:*` passes them itself.
MEMBER_ACCOUNT_PUBLIC_KEY=
NETWORK_MEMBER_COMMITMENT=
