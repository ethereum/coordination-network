{
    "name": "@coordination-network/user-app-link",
    "version": "0.2.1",
    "description": "Deep-link protocol between the user app (keys, credentials, proving) and network member apps on the same device.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/user-app-link"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/user-app-link",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./web": {
            "types": "./types/web.d.ts",
            "require": "./dist/web.cjs",
            "default": "./dist/web.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs"
    },
    "dependencies": {
        "zod": "^4.3.11"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.3.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "typescript": "^6.0.3"
    }
}
