--- a/MoproReactNativeBindings/android/build.gradle
+++ b/MoproReactNativeBindings/android/build.gradle
@@ -21,6 +21,22 @@
   return value ? value.split(",") : ["armeabi-v7a", "x86", "x86_64", "arm64-v8a"]
 }
 
+// Android loads an APK's native libs for the most preferred device ABI it has libs for, and a
+// debug `expo run:android` requests the device's ABIs in that order, so an APK without the
+// prover for the first one would install and fail only at proof time.
+def prebuiltArchitectures() {
+  def hasLib = { abi -> file("src/main/jniLibs/$abi/libnoir_prover_native.so").exists() }
+  def requested = reactNativeArchitectures()
+  if (!hasLib(requested[0])) {
+    def available = ["armeabi-v7a", "x86", "x86_64", "arm64-v8a"].findAll(hasLib)
+    if (available.isEmpty()) {
+      throw new GradleException("no libnoir_prover_native.so under android/src/main/jniLibs; run scripts/fetch-android-libs.sh")
+    }
+    throw new GradleException("libnoir_prover_native.so ships for ${available} only, not ${requested[0]}, the first ABI in ${requested}")
+  }
+  return requested.findAll(hasLib)
+}
+
 def isNewArchitectureEnabled() {
   return rootProject.hasProperty("newArchEnabled") && rootProject.getProperty("newArchEnabled") == "true"
 }
@@ -75,11 +91,11 @@
     externalNativeBuild {
       cmake {
         arguments '-DANDROID_STL=c++_shared'
-        abiFilters (*reactNativeArchitectures())
+        abiFilters (*prebuiltArchitectures())
       }
     }
     ndk {
-      abiFilters "arm64-v8a", "armeabi-v7a", "x86", "x86_64"
+      abiFilters (*prebuiltArchitectures())
     }
   }
 
