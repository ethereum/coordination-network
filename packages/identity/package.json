{
    "name": "@coordination-network/identity",
    "version": "0.2.1",
    "description": "Deterministic device key derivation for the coordination network: networkId and the four-key secp256k1 model (account, spending, viewing, auth) from one device secret, plus a hardware-rooted Baby Jubjub EdDSA/Semaphore-commitment fifth key.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ethereum/coordination-network.git",
        "directory": "packages/identity"
    },
    "homepage": "https://github.com/ethereum/coordination-network/tree/main/packages/identity",
    "bugs": "https://github.com/ethereum/coordination-network/issues",
    "sideEffects": false,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/",
        "types/",
        "src/",
        "README.md",
        "DERIVATION.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist types && rollup -c rollup.config.mjs"
    },
    "dependencies": {
        "@noble/curves": "^1.9.7",
        "@noble/hashes": "^1.8.0",
        "@zk-kit/eddsa-poseidon": "1.0.4",
        "poseidon-lite": "0.3.0"
    },
    "devDependencies": {
        "@fluidkey/stealth-account-kit": "1.1.1",
        "@rollup/plugin-typescript": "^12.3.0",
        "@scopelift/stealth-address-sdk": "^1.0.0-beta.5",
        "@semaphore-protocol/identity": "4.14.5",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.0",
        "typescript": "^6.0.3"
    }
}
